# TuneSphere — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Database ──────────────────────────────────────────────────────────────────
# Development: leave empty to use local SQLite (database/music.db)
# Production:  set a PostgreSQL connection string
DATABASE_URL=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate a secure random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL the Next.js frontend uses to reach the FastAPI backend
# Development: http://localhost:8000
# Production:  https://your-project.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to the music dataset CSV (relative to project root)
MUSIC_DATA_PATH=data/raw/songs.csv
